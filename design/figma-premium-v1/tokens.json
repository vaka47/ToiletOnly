{
  "meta": {
    "name": "ToiletOnly Premium Tokens",
    "version": "1.0.0",
    "theme": "dark-luxury"
  },
  "colors": {
    "bg/base": "#08090D",
    "bg/elevated": "#0F1118",
    "bg/glass": "rgba(255,255,255,0.10)",
    "bg/overlay/strong": "rgba(0,0,0,0.72)",
    "bg/overlay/soft": "rgba(0,0,0,0.36)",
    "text/primary": "#F5F7FF",
    "text/secondary": "#A8B0C2",
    "text/tertiary": "#7C8599",
    "brand/coral": "#FF5D6B",
    "brand/mango": "#FFB347",
    "brand/sky": "#5F8BFF",
    "brand/mint": "#2DD4A7",
    "status/success": "#32D583",
    "status/warning": "#FDB022",
    "status/error": "#F04438",
    "stroke/soft": "rgba(255,255,255,0.14)",
    "stroke/strong": "rgba(255,255,255,0.26)"
  },
  "gradients": {
    "brand/primary": {
      "type": "linear",
      "angle": 128,
      "stops": [
        { "color": "#FF5D6B", "position": 0 },
        { "color": "#FF8A5B", "position": 45 },
        { "color": "#FFB347", "position": 100 }
      ]
    },
    "brand/secondary": {
      "type": "linear",
      "angle": 140,
      "stops": [
        { "color": "#5F8BFF", "position": 0 },
        { "color": "#2DD4A7", "position": 100 }
      ]
    },
    "overlay/video": {
      "type": "linear",
      "angle": 180,
      "stops": [
        { "color": "rgba(0,0,0,0.52)", "position": 0 },
        { "color": "rgba(0,0,0,0.06)", "position": 35 },
        { "color": "rgba(0,0,0,0.84)", "position": 100 }
      ]
    }
  },
  "typography": {
    "fontFamily/display": "SF Pro Display",
    "fontFamily/text": "SF Pro Text",
    "h1": { "size": 34, "lineHeight": 40, "weight": 700 },
    "h2": { "size": 28, "lineHeight": 34, "weight": 700 },
    "h3": { "size": 22, "lineHeight": 28, "weight": 700 },
    "title": { "size": 18, "lineHeight": 24, "weight": 600 },
    "body": { "size": 16, "lineHeight": 22, "weight": 500 },
    "caption": { "size": 13, "lineHeight": 18, "weight": 500 },
    "micro": { "size": 11, "lineHeight": 14, "weight": 600 }
  },
  "radius": {
    "xs": 10,
    "sm": 14,
    "md": 18,
    "lg": 24,
    "xl": 32,
    "pill": 999
  },
  "spacing": {
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "20": 20,
    "24": 24,
    "32": 32
  },
  "shadow": {
    "soft": "0 8 24 rgba(0,0,0,0.24)",
    "elevated": "0 18 48 rgba(0,0,0,0.38)",
    "floating": "0 24 60 rgba(0,0,0,0.45)"
  },
  "blur": {
    "glass": 24,
    "overlay": 8
  },
  "motion": {
    "duration/fast": 160,
    "duration/base": 240,
    "duration/slow": 360,
    "curve/standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "curve/emphasis": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
